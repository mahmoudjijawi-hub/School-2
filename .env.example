# إعدادات بيئة نظام المعاهد - نسخة تجريبية

# مفتاح Django السري (غيّره في الإنتاج!)
SECRET_KEY=your-secret-key-here-change-me

# وضع التطوير (True للتطوير المحلي، False للإنتاج)
DEBUG=True

# النطاقات المسموحة (افصل بينها بفاصلة) — يُتجاهل عند DEBUG=True و ALLOW_ALL_HOSTS=true
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,.cursorvm.com

# السماح بكل المضيفين في وضع التطوير (للاختبار عبر Cursor)
ALLOW_ALL_HOSTS=true

# إعدادات كوكيز Cursor (SameSite=None) — اضبط false للتطوير المحلي العادي
CURSOR_DEV=true

# مصادر CSRF إضافية (افصل بينها بفاصلة) — مثال: https://myapp.onrender.com
# CSRF_TRUSTED_ORIGINS=https://myapp.onrender.com
